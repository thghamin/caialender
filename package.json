{
  "name": "caialender",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:push": "node --env-file=.env.local scripts/db-push.mjs",
    "make-admin": "node --env-file=.env.local scripts/make-admin.mjs",
    "test:rls": "INTEGRATION=1 node --env-file=.env.local node_modules/.bin/vitest run tests/rls.integration.test.ts",
    "test:e2e": "node --env-file=.env.local node_modules/.bin/playwright test",
    "setup-cron": "node --env-file=.env.local scripts/setup-cron.mjs",
    "import-academic": "node --env-file=.env.local --no-warnings scripts/import-academic.mjs"
  },
  "dependencies": {
    "@fullcalendar/react": "^7.1.3",
